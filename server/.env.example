# Copy to `server/.env` and adjust. Never commit the real .env.

# Port the API server listens on (default 5000)
PORT=5000

# Admin/operator token that protects destructive & admin API routes
# (library scan/clear, series delete, uploads, downloads, library paths,
# user deletion). When UNSET, those routes are open and the server logs a
# loud warning on first use. SET THIS for any network-exposed deployment.
# The web client sends it via localStorage key `adminToken`.
ADMIN_TOKEN=

# Comma-separated list of browser origins allowed to call the API (CORS).
# Defaults to the local Vite dev client if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size for library video uploads, in bytes (default 10 GiB).
MAX_UPLOAD_BYTES=10737418240
